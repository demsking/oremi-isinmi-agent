# Oremi Isinmi environment configuration.
# All variables must use the OREMI_ISINMI_ prefix.
# Keep values unquoted so Docker --env-file reads them correctly.

# API prefix for all application routes. Use "/" to serve routes at the root.
OREMI_ISINMI_API_PREFIX=/

# Network binding for the Oremi Isinmi server.
# Use 0.0.0.0 for Docker or LAN access, or 127.0.0.1 for local-only access.
OREMI_ISINMI_SERVER_HOST=0.0.0.0

# Default API port.
OREMI_ISINMI_SERVER_PORT=5073

# SQLCipher-encrypted SQLite database location.
# OREMI_ISINMI_DATABASE_URL=sqlite:///./data/oremi_isinmi.db

# Required SQLCipher encryption key.
# Development value only. Replace before storing real data.
# Must be at least 32 characters long.
OREMI_ISINMI_DATABASE_ENCRYPTION_KEY=dev-only-change-this-key-32-chars-minimum

# Logging level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
OREMI_ISINMI_LOG_LEVEL=INFO

# Server-Sent Events client retry interval in seconds. Valid range: 1-120.
OREMI_ISINMI_SSE_RETRY_TIMEOUT_SECONDS=30

# Maximum time to wait for a CalDAV server response, in seconds.
# Valid range: 1-300.
OREMI_ISINMI_CALDAV_REQUEST_TIMEOUT_SECONDS=30
